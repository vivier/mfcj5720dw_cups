msgid "The print queue changed. Select the maintenance operation again."
msgstr "La file d’impression a changé. Sélectionnez à nouveau l’opération de maintenance."

msgid "Start print head cleaning?"
msgstr "Lancer le nettoyage des têtes ?"

#, c-format
msgid "%s\nPrint queue: %s\n\nCleaning consumes ink. Strong and strongest cleaning use more ink than normal cleaning."
msgstr "%s\nFile d’impression : %s\n\nLe nettoyage consomme de l’encre. Les modes intensif et très intensif en utilisent davantage que le nettoyage normal."

msgid "Cancel"
msgstr "Annuler"

msgid "Start cleaning"
msgstr "Lancer le nettoyage"


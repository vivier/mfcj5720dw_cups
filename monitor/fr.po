msgstr "Impossible de lire les opérations de maintenance disponibles pour %s : %s"

msgid "This print queue does not support the selected maintenance operation."
msgstr "Cette file d’impression ne prend pas en charge l’opération de maintenance sélectionnée."

msgid "This print queue is not accepting jobs."
msgstr "Cette file d’impression n’accepte pas de travaux."

#, c-format
msgid "CUPS rejected the maintenance request: %s"
msgstr "CUPS a refusé la demande de maintenance : %s"

msgid "CUPS did not confirm the maintenance request. Check the queue before trying again."
msgstr "CUPS n’a pas confirmé la demande de maintenance. Vérifiez la file d’impression avant de réessayer."

#, c-format
msgid "%s: job #%d submitted to %s."
msgstr "%s : travail n° %d transmis à %s."

msgid "Requesting updated CUPS ink levels…"
msgstr "Demande d’actualisation des niveaux d’encre CUPS…"


// Brother MFC-J5720DW description for the direct CUPS Raster filter.
#define NoPostScript "          "

{
	Manufacturer "Brother"
	ModelName "MFC-J5720DW"
	FileName "mfcj5720dw.ppd"
	PCFileName "MFC5720R.PPD"
	Version "4.0.4"
	DriverType ps
	ModelNumber 17
	ManualCopies Yes
	ColorDevice Yes
	Throughput 12
	Attribute "NickName" "" "Brother MFC-J5720DW CUPS"
	Attribute "ShortNickName" "" "MFC-J5720DW"
	Attribute "Product" "" "(MFC-J5720DW)"
	Attribute "1284DeviceID" "" "MFG:Brother;MDL:MFC-J5720DW"
	Attribute "PSVersion" "" "(3010.106) 3"
	Attribute "ISOCountryCode" "" "JP"
	Attribute "LanguageLevel" "" "3"
	Attribute "DefaultColorSpace" "" "RGB"
	Attribute "FileSystem" "" "False"
	Attribute "TTRasterizer" "" "Type42"
	Attribute "FreeVM" "" "1700000"
	Attribute "DefaultOutputOrder" "" "Reverse"

	// The original omits LandscapeOrientation: CUPS then uses Minus90.
	// ppdc would otherwise generate Plus90 and reverse landscape rotation.
	Attribute "LandscapeOrientation" "" "Minus90"
	Attribute "VariablePaperSize" "" "False"
	Attribute "cupsVersion" "" "1.4"
	// The encoder handles the printer-specific duplex rotation.
	Attribute "cupsBackSide" "" "Normal"
	// Brother's private maintenance OID provides the actual ink estimates.
	// Disable generic polling so Printer-MIB sentinels cannot overwrite them.
	Attribute "cupsSNMPSupplies" "" "False"
	Attribute "cupsCommands" "" "ReportLevels"

	// CUPS performs PDF/PostScript rendering and page management upstream.
	Filter "application/vnd.cups-raster 0 rastertomfcj5720dw"
	Filter "application/vnd.cups-command 0 mfcj5720dw_ink"

	// Width, height and margins in PostScript points (1/72 inch).
	// Preserve Brother's rounded dimensions instead of generic media.defs.
	// Arguments: name width height left bottom right top size-code region-code.
	CustomMedia "A3/A3" 842 1191 9 9 9 9 "<</PageSize[842 1191]/ImagingBBox null>>setpagedevice" "<</PageSize[842 1191]/ImagingBBox null>>setpagedevice"
	CustomMedia "BrA3_B_S/A3 (Borderless)" 842 1191 0 0 0 0 "<</PageSize[842 1191]/ImagingBBox null>>setpagedevice" "<</PageSize[842 1191]/ImagingBBox null>>setpagedevice"
	CustomMedia "B4_S/JB4" 729 1032 9 9 9 9 "<</PageSize[729 1032]/ImagingBBox null>>setpagedevice" "<</PageSize[729 1032]/ImagingBBox null>>setpagedevice"
	CustomMedia "Tabloid_S/Tabloid" 792 1224 9 9 9 9 "<</PageSize[792 1224]/ImagingBBox null>>setpagedevice" "<</PageSize[792 1224]/ImagingBBox null>>setpagedevice"
	CustomMedia "BrLedger_B_B/Tabloid (Borderless)" 792 1224 0 0 0 0 "<</PageSize[792 1224]/ImagingBBox null>>setpagedevice" "<</PageSize[792 1224]/ImagingBBox null>>setpagedevice"
	CustomMedia "A4/A4" 595 842 9 9 9 9 "<</PageSize[595 842]/ImagingBBox null>>setpagedevice" "<</PageSize[595 842]/ImagingBBox null>>setpagedevice"
	CustomMedia "BrA4_B/A4 (Borderless)" 595 842 0 0 0 0 "<</PageSize[595 842]/ImagingBBox null>>setpagedevice" "<</PageSize[595 842]/ImagingBBox null>>setpagedevice"
	*CustomMedia "Letter/Letter" 612 792 9 9 9 9 "<</PageSize[612 792]/ImagingBBox null>>setpagedevice" "<</PageSize[612 792]/ImagingBBox null>>setpagedevice"
	CustomMedia "BrLetter_B/Letter (Borderless)" 612 792 0 0 0 0 "<</PageSize[612 792]/ImagingBBox null>>setpagedevice" "<</PageSize[612 792]/ImagingBBox null>>setpagedevice"
	CustomMedia "Legal/Legal" 612 1008 9 9 9 9 "<</PageSize[612 1008]/ImagingBBox null>>setpagedevice" "<</PageSize[612 1008]/ImagingBBox null>>setpagedevice"
	CustomMedia "Folio/Folio" 612 936 9 9 9 9 "<</PageSize[612 936]/ImagingBBox null>>setpagedevice" "<</PageSize[612 936]/ImagingBBox null>>setpagedevice"
	CustomMedia "Executive/Executive" 522 756 9 9 9 9 "<</PageSize[522 756]/ImagingBBox null>>setpagedevice" "<</PageSize[522 756]/ImagingBBox null>>setpagedevice"
	CustomMedia "B5/JIS B5" 516 729 9 9 9 9 "<</PageSize[516 729]/ImagingBBox null>>setpagedevice" "<</PageSize[516 729]/ImagingBBox null>>setpagedevice"
	CustomMedia "A5/A5" 420 595 9 9 9 9 "<</PageSize[420 595]/ImagingBBox null>>setpagedevice" "<</PageSize[420 595]/ImagingBBox null>>setpagedevice"
	CustomMedia "A6/A6" 297 420 9 9 9 9 "<</PageSize[297 420]/ImagingBBox null>>setpagedevice" "<</PageSize[297 420]/ImagingBBox null>>setpagedevice"
	CustomMedia "BrA6_B/A6 (Borderless)" 297 420 0 0 0 0 "<</PageSize[297 420]/ImagingBBox null>>setpagedevice" "<</PageSize[297 420]/ImagingBBox null>>setpagedevice"
	CustomMedia "BrPostC4x6_S/4 x 6 in" 288 432 9 9 9 9 "<</PageSize[288 432]/ImagingBBox null>>setpagedevice" "<</PageSize[288 432]/ImagingBBox null>>setpagedevice"
	CustomMedia "BrPostC4x6_B/4 x 6 in (Borderless)" 288 432 0 0 0 0 "<</PageSize[288 432]/ImagingBBox null>>setpagedevice" "<</PageSize[288 432]/ImagingBBox null>>setpagedevice"
	CustomMedia "BrIndexC5x8_S/5 x 8 in" 360 576 9 9 9 9 "<</PageSize[360 576]/ImagingBBox null>>setpagedevice" "<</PageSize[360 576]/ImagingBBox null>>setpagedevice"
	CustomMedia "BrIndexC5x8_B/5 x 8 in (Borderless)" 360 576 0 0 0 0 "<</PageSize[360 576]/ImagingBBox null>>setpagedevice" "<</PageSize[360 576]/ImagingBBox null>>setpagedevice"
	CustomMedia "BrPhotoL_S/3.5 x 5 in" 252 360 9 9 9 9 "<</PageSize[252 360]/ImagingBBox null>>setpagedevice" "<</PageSize[252 360]/ImagingBBox null>>setpagedevice"
	CustomMedia "BrPhotoL_B/3.5 x 5 in (Borderless)" 252 360 0 0 0 0 "<</PageSize[252 360]/ImagingBBox null>>setpagedevice" "<</PageSize[252 360]/ImagingBBox null>>setpagedevice"
	CustomMedia "BrPhoto2L_S/5 x 7 in" 359 505 9 9 9 9 "<</PageSize[359 505]/ImagingBBox null>>setpagedevice" "<</PageSize[359 505]/ImagingBBox null>>setpagedevice"
	CustomMedia "BrPhoto2L_B/5 x 7 in (Borderless)" 359 505 0 0 0 0 "<</PageSize[359 505]/ImagingBBox null>>setpagedevice" "<</PageSize[359 505]/ImagingBBox null>>setpagedevice"
	CustomMedia "Postcard/Postcard 1" 284 419 9 9 9 9 "<</PageSize[284 419]/ImagingBBox null>>setpagedevice" "<</PageSize[284 419]/ImagingBBox null>>setpagedevice"
	CustomMedia "BrHagaki_B/Postcard 1 (Borderless)" 284 419 0 0 0 0 "<</PageSize[284 419]/ImagingBBox null>>setpagedevice" "<</PageSize[284 419]/ImagingBBox null>>setpagedevice"
	CustomMedia "DoublePostcardRotated/Postcard 2 (Double)" 420 567 9 9 9 9 "<</PageSize[420 567]/ImagingBBox null>>setpagedevice" "<</PageSize[420 567]/ImagingBBox null>>setpagedevice"
	CustomMedia "EnvC5/C5 Envelope" 459 649 9 62 9 34 "<</PageSize[459 649]/ImagingBBox null>>setpagedevice" "<</PageSize[459 649]/ImagingBBox null>>setpagedevice"
	CustomMedia "EnvDL/DL Envelope" 312 624 9 62 9 34 "<</PageSize[312 624]/ImagingBBox null>>setpagedevice" "<</PageSize[312 624]/ImagingBBox null>>setpagedevice"
	CustomMedia "Env10/Com-10" 297 684 9 62 9 34 "<</PageSize[297 684]/ImagingBBox null>>setpagedevice" "<</PageSize[297 684]/ImagingBBox null>>setpagedevice"
	CustomMedia "EnvMonarch/Monarch" 279 540 9 62 9 34 "<</PageSize[279 540]/ImagingBBox null>>setpagedevice" "<</PageSize[279 540]/ImagingBBox null>>setpagedevice"
	CustomMedia "EnvC6/C6 Envelope" 323 459 9 62 9 34 "<</PageSize[323 459]/ImagingBBox null>>setpagedevice" "<</PageSize[323 459]/ImagingBBox null>>setpagedevice"
	CustomMedia "EnvYou4/Y4 Envelope" 298 666 9 62 9 34 "<</PageSize[298 666]/ImagingBBox null>>setpagedevice" "<</PageSize[298 666]/ImagingBBox null>>setpagedevice"

	// Printer controls and their presentation in the CUPS options dialog.

	Group "General/General"

		// Standard Duplex lets CUPS pad odd reversed jobs before rasterization.
		Option "Duplex/Two-Sided" PickOne AnySetup 25
			Choice "DuplexTumble/Short-Edge Binding" "<</Duplex true/Tumble true>>setpagedevice"
			Choice "DuplexNoTumble/Long-Edge Binding" "<</Duplex true/Tumble false>>setpagedevice"
			*Choice "None/Off" "<</Duplex false/Tumble false>>setpagedevice"

		Option "BRInputSlot/Paper Source" PickOne AnySetup 13
			*Choice "AutoSelect/Auto Select" $NoPostScript
			Choice "Tray1/Tray1" $NoPostScript
			Choice "Tray2/Tray2" $NoPostScript
			Choice "MPTray/MP Tray" $NoPostScript

		Option "BRResolution/Print Quality" PickOne AnySetup 14
			Choice "PlainFast/Plain Fast" "<</HWResolution[150 150]/cupsBitsPerColor 8/cupsColorSpace 1/cupsColorOrder 0>>setpagedevice"
			*Choice "PlainNormal/Plain Normal" "<</HWResolution[600 600]/cupsBitsPerColor 8/cupsColorSpace 1/cupsColorOrder 0>>setpagedevice"
			Choice "Fast/Fast" "<</HWResolution[600 600]/cupsBitsPerColor 8/cupsColorSpace 1/cupsColorOrder 0>>setpagedevice"
			Choice "Normal/Normal" "<</HWResolution[600 600]/cupsBitsPerColor 8/cupsColorSpace 1/cupsColorOrder 0>>setpagedevice"
			Choice "Photo/Photo" "<</HWResolution[600 600]/cupsBitsPerColor 8/cupsColorSpace 1/cupsColorOrder 0>>setpagedevice"
			Choice "Best/Best" "<</HWResolution[600 600]/cupsBitsPerColor 8/cupsColorSpace 1/cupsColorOrder 0>>setpagedevice"

		Option "BRMonoColor/Color / Grayscale" PickOne AnySetup 15
			*Choice "Color/Color" $NoPostScript
			Choice "Mono/Grayscale" $NoPostScript

		// Factory correction is specific to the physical printer, not the paper profile.
		Option "BRCalibration/Printhead Calibration" PickOne AnySetup 40
			*Choice "Auto/Automatic" $NoPostScript
			Choice "Refresh/Refresh Before Each Job" $NoPostScript
			Choice "Off/Disabled" $NoPostScript

		Option "BRSlowDrying/Slow Drying Paper" PickOne AnySetup 31
			*Choice "OFF/Off" $NoPostScript
			Choice "ON/On" $NoPostScript

		Option "BRMediaType/Media Type" PickOne AnySetup 16
			Choice "PlainDuplex/Plain Duplex Paper" $NoPostScript
			*Choice "Plain/Plain Paper" $NoPostScript
			Choice "Inkjet/Inkjet Paper" $NoPostScript
			Choice "BrotherGlossyR/Brother BP71 Photo Paper" $NoPostScript
			Choice "BrotherBP60Matte/Brother BP60 Matte Paper" $NoPostScript
			Choice "Glossy/Other Photo Paper" $NoPostScript
			Choice "HagakiAtena/HagakiAtena" $NoPostScript
			Choice "HagakiUra/HagakiUra" $NoPostScript

		Option "BRColorPaperThick/Paper Thickness" PickOne AnySetup 17
			*Choice "Regular/Regular" $NoPostScript
			Choice "Thick/Thick" $NoPostScript
			Choice "Env/Envelope" $NoPostScript

		Option "BRBiDir/Bi-Directional Printing" PickOne AnySetup 18
			Choice "OFF/Off" $NoPostScript
			*Choice "ON/On" $NoPostScript

		Option "BRColorMatching/Color Mode" PickOne AnySetup 21
			Choice "Natural/Natural" $NoPostScript
			*Choice "Vivid/Vivid" $NoPostScript
			Choice "None/None" $NoPostScript

		Option "BRJpeg/Change Data Transfer Mode" PickOne AnySetup 22
			*Choice "Recommended/Recommended Setting" $NoPostScript
			Choice "QualityPrior/Improved Print Quality" $NoPostScript
			Choice "SpeedPrior/Improved Print Speed" $NoPostScript

		Option "BRDuplexMode/Advanced Two-Sided Settings" PickOne AnySetup 32
			*Choice "Normal/Normal" $NoPostScript
			Choice "Duplex1/Two-Sided 1 (Slower print speed)" $NoPostScript
			Choice "Duplex2/Two-Sided 2 (Slower print speed & less ink)" $NoPostScript

	Group "Vertical Line Alignment/Vertical Line Alignment"

		Option "BRVertLineAlignA3B4Ledger/Vertical Line Alignment A3, JIS B4, Ledger" PickOne AnySetup 32
			*Choice "OFF/Off" $NoPostScript
			Choice "ON/On" $NoPostScript

		Option "BRVertLineAlignA4Letter/Vertical Line Alignment A4, Letter" PickOne AnySetup 33
			*Choice "OFF/Off" $NoPostScript
			Choice "ON/On" $NoPostScript

		Option "BRVertLineAlignOther/Vertical Line Alignment Other Sizes" PickOne AnySetup 34
			*Choice "OFF/Off" $NoPostScript
			Choice "ON/On" $NoPostScript

	Group "Color Settings (Advanced)/Color Settings (Advanced)"

		Option "BRHalfTonePattern/Halftone Pattern" PickOne AnySetup 23
			Choice "Diffusion/Diffusion" $NoPostScript
			*Choice "Dither/Dither" $NoPostScript

		Option "BRColorEnhancement/Color Enhancement" PickOne AnySetup 24
			*Choice "OFF/Off" $NoPostScript
			Choice "ON/On" $NoPostScript


	// Invalid combinations, enforced by CUPS and printer setup tools.
	// ppdc emits both directions of each constraint.
	UIConstraints "*PageSize Folio *BRInputSlot Tray1"
	UIConstraints "*PageSize EnvC5 *BRInputSlot Tray2"
	UIConstraints "*PageSize Executive *BRInputSlot Tray2"
	UIConstraints "*PageSize Folio *BRInputSlot Tray2"
	UIConstraints "*PageSize B5 *BRInputSlot Tray2"
	UIConstraints "*PageSize A5 *BRInputSlot Tray2"
	UIConstraints "*PageSize A6 *BRInputSlot Tray2"
	UIConstraints "*PageSize BrA6_B *BRInputSlot Tray2"

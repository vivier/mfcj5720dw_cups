	UIConstraints "*PageSize BrPostC4x6_B *BRInputSlot Tray2"
	UIConstraints "*PageSize BrIndexC5x8_S *BRInputSlot Tray2"
	UIConstraints "*PageSize BrIndexC5x8_B *BRInputSlot Tray2"
